{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/following-cache", "destination": "/index.html" },
    { "source": "/following-cache/", "destination": "/index.html" },
    { "source": "/app-usage", "destination": "/index.html" },
    { "source": "/app-controls", "destination": "/index.html" },
    { "source": "/app-usage/", "destination": "/index.html" },
    { "source": "/app-controls/", "destination": "/index.html" },
    { "source": "/users", "destination": "/index.html" },
    { "source": "/users/", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/account/", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
  ] }],
  "functions": { "api/releases.js": { "maxDuration": 60 }, "api/*.js": { "maxDuration": 10 } },
  "crons": [{ "path": "/api/cleanup", "schedule": "0 3 * * *" }]
}
