# Illustrative Mobilism API request. Placeholders are not literal header values.
# versionName and versionCode come from the APK metadata generated by app/build.gradle.kts.
# The same versionName selects CHANGELOG.md release notes during the build.
# Signed-in requests also carry an X-Auth-Token. Browser cookies may be included.
# Neither credentials nor cookies are shown here.
GET https://app.mobilism.org/api-new/release/category
Accept: application/json
User-Agent: <Android WebView user agent or configured prefix> MobilismMaterial/{{versionName}} (Android; build {{versionCode}})
